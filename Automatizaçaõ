  },
  GPS: {
    servico_prestado          : 57,  // Col 58
    nivel_satisfacao_equipe   : 58,  // Col 59
    nivel_satisfacao_prof     : 59,  // Col 60
    nivel_satisfacao_espera   : 60,  // Col 61
    resolvido                 : 61,  // Col 62
    obs_nao_resolvido         : 62,  // Col 63
    treinamento               : null,
    avaliacao_treinamento     : 63,  // Col 64
    satisfacao_treinamento    : 64,  // Col 65
    avaliacao_profissional    : 65,  // Col 66
  },
  SPS: {
    servico_prestado          : 66,  // Col 67
    nivel_satisfacao_equipe   : 67,  // Col 68
    nivel_satisfacao_prof     : 68,  // Col 69
    nivel_satisfacao_espera   : 69,  // Col 70
    resolvido                 : 70,  // Col 71
    obs_nao_resolvido         : 71,  // Col 72
    treinamento               : null,
    avaliacao_treinamento     : 72,  // Col 73
