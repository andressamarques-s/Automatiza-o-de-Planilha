const IDX_UNIDADES = Array.from({length: 28}, (_, i) => i + 5);

// Profissional: colunas 35 a 38 (índices 34 a 37) — pega a primeira preenchida
const IDX_PROFISSIONAIS = [34, 35, 36, 37];

// Campos condicionais por área
const AREAS = {
  SST: {
